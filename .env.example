# ShopCase Environment Configuration Example
ENDORPHONE_API_KEY=your_endorphone_api_key_here
ENDORPHONE_BASE_URL=https://api.endorphone.com.ua/1.0
USE_MOCK_DATA=false
CRON_TOKEN=your_random_cron_secret_token_here

# Нова Пошта API v2 (опціонально, є вбудований офлайн-довідник)
NOVA_POSHTA_API_KEY=your_nova_poshta_api_key_here

# Telegram Сповіщення для адміністратора
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Пароль для входу в Адмін-панель (/admin.php)
ADMIN_PASSWORD=your_secure_admin_password

# FTP Deployment
FTP_HOST=s12.thehost.com.ua
FTP_PORT=21
FTP_USER=sc
FTP_PASS=your_ftp_password_here

